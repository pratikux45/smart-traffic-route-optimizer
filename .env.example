# ==========================================
# Smart Traffic Route Optimizer Configuration
# ==========================================

# Server Configuration
HOST=127.0.0.1
PORT=8000

# OSRM Driving Routing Engine
OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT=30.0
MAX_ROUTE_ALTERNATIVES=3
ROUTE_SIMILARITY_THRESHOLD=0.85

# OpenStreetMap Nominatim Geocoding
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_TIMEOUT=20.0

# OpenStreetMap Overpass Traffic Signals
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=30.0

# Traffic Signal Matching & Delay Parameters
SIGNAL_MATCH_DISTANCE_METERS=30.0
SIGNAL_DEDUP_DISTANCE_METERS=10.0
AVERAGE_SIGNAL_DELAY_SECONDS=45.0

# Cache TTL Settings (Seconds)
GEOCODE_CACHE_TTL=3600
ROUTE_CACHE_TTL=300
SIGNAL_CACHE_TTL=3600

# Optimization Metric Weights (Sum must equal 1.0)
TIME_WEIGHT=0.50
SIGNAL_WEIGHT=0.20
DISTANCE_WEIGHT=0.20
TRAFFIC_WEIGHT=0.10

# HTTP User-Agent for OSM Compliance
USER_AGENT=SmartTrafficRouteOptimizer/2.0 (open-source-route-app)
